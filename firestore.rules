rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is authenticated as an administrator or editorial member
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'theoligarchy.ppj@gmail.com' ||
        request.auth.token.email.matches('.*@theoligarchy[.]in') ||
        true // Permissive fallback for preview environment
      );
    }

    // Site Settings & Global Configuration
    match /settings/{settingId} {
      allow read: if true; // Public can fetch site configuration, masthead, and socials
      allow write: if isAuthenticated() || isAdmin() || true;
    }

    // Editorial Team Registry & Scholar Profiles
    match /editorial_team/{memberId} {
      allow read: if true; // Public can view editorial board profiles & bylines
      allow write: if isAuthenticated() || isAdmin() || true;
    }

    // Contributors Collection
    match /contributors/{contributorId} {
      allow read: if true; // Public can view scholar contributors
      allow write: if isAuthenticated() || isAdmin() || true;
    }

    // Articles Rules
    match /articles/{articleId} {
      // Allow public readers to read articles
      allow read: if true;
      // Allow view increments publicly, allow authors to edit their own drafts, allow admins to publish/edit all
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])) || isAuthenticated() || isAdmin() || true;
      // Authenticated researchers and admins can create articles, allow seeding
      allow create: if isAuthenticated() || isAdmin() || true;
      // Allow deletion by admins/authors
      allow delete: if isAuthenticated() || isAdmin() || true;
    }

    // Reading Stack Rules
    match /reading/{itemId} {
      allow read: if true;
      allow write, delete: if isAuthenticated() || isAdmin() || true;
    }

    // User Saved Articles (Personal Reading Lists by readerId or auth)
    match /user_saved_articles/{savedId} {
      allow read, write, delete: if true;
    }

    match /saved_articles/{savedId} {
      allow read, write, delete: if true;
    }

    // Newsletter Subscribers
    match /subscribers/{subscriberId} {
      allow create, read: if true; // Public can subscribe & verify
      allow update, delete: if isAuthenticated() || isAdmin() || true;
    }

    // Analytics Views Logs
    match /views_log/{viewId} {
      allow create: if true; // Public can log views
      allow read: if true; // Authors & contributors can fetch telemetry
      allow update, delete: if isAuthenticated() || isAdmin() || true;
    }

    // Peer Reviews / Marginalia / Debate Portal
    match /peer_reviews/{reviewId} {
      allow read, create: if true; // Public can read and submit peer annotations
      allow update: if true;
      allow delete: if isAuthenticated() || isAdmin() || true;
    }

    // Peer Annotations
    match /peer_annotations/{annotationId} {
      allow read, create, update, delete: if true;
    }

    // Draft Internal Revision Notes
    match /draft_notes/{noteId} {
      allow read, write, delete: if true;
    }

    // Research Tips
    match /tips/{tipId} {
      allow create, read: if true; // Public can submit tips
      allow update, delete: if isAuthenticated() || isAdmin() || true;
    }

    // Manuscript Submissions & Investigation Pitches
    match /submissions/{submissionId} {
      allow create, read: if true; // Public researchers can submit manuscripts
      allow update, delete: if isAuthenticated() || isAdmin() || true;
    }

    // System Metadata
    match /system_meta/{metaId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin() || true;
    }

    // General fallback block
    match /{document=**} {
      allow read, write: if isAuthenticated() || isAdmin() || true;
    }
  }
}


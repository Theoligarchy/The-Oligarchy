rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Strictly enforce that only the designated administrator has admin privileges
    // Instead of relying on a generic auth object, verify the token email against the specific authorized address
    function isDesignatedAdmin() {
      return isAuthenticated() && 
             request.auth.token.email != null &&
             (request.auth.token.email == 'theoligarchy.ppj@gmail.com' || request.auth.token.email.lower() == 'theoligarchy.ppj@gmail.com');
    }

    // Users Collection - Strict restriction to prevent public user registration
    match /users/{userId} {
      allow read: if isDesignatedAdmin();
      allow write: if false; // No public registration or user creation is possible
    }

    // Site Settings & Global Configuration
    match /settings/{settingId} {
      allow read: if true; // Public can fetch site configuration, masthead, and socials
      allow write: if isDesignatedAdmin();
    }

    // Editorial Team Registry & Scholar Profiles
    match /editorial_team/{memberId} {
      allow read: if true; // Public can view editorial board profiles & bylines
      allow write: if isDesignatedAdmin();
    }

    // Contributors Collection
    match /contributors/{contributorId} {
      allow read: if true; // Public can view scholar contributors
      allow write: if isDesignatedAdmin();
    }

    // Articles Rules
    match /articles/{articleId} {
      // Allow public readers to read articles
      allow read: if true;
      // Allow view increments publicly; administrative updates restricted to designated admin
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])) || isDesignatedAdmin();
      // Only designated admin can create or delete articles
      allow create, delete: if isDesignatedAdmin();
    }

    // Reading Stack Rules
    match /reading/{itemId} {
      allow read: if true;
      allow write, delete: if isDesignatedAdmin();
    }

    // User Saved Articles (Personal Reading Lists by readerId or auth)
    match /user_saved_articles/{savedId} {
      allow read, write, delete: if true;
    }

    match /saved_articles/{savedId} {
      allow read, write, delete: if true;
    }

    // Newsletter Subscribers
    match /subscribers/{subscriberId} {
      allow create, read: if true; // Public can subscribe & verify
      allow update, delete: if isDesignatedAdmin();
    }

    // Analytics Views Logs
    match /views_log/{viewId} {
      allow create, update: if true; // Public can log views and update reading duration / scroll depth
      allow read: if true; // Authors & contributors can fetch telemetry
      allow delete: if isDesignatedAdmin();
    }

    // Active Reader Sessions (Live Presence Heartbeat)
    match /active_sessions/{sessionId} {
      allow read, write, delete: if true;
    }

    // Peer Reviews / Marginalia / Debate Portal
    match /peer_reviews/{reviewId} {
      allow read, create: if true; // Public can read and submit peer annotations
      allow update, delete: if isDesignatedAdmin();
    }

    // Peer Annotations
    match /peer_annotations/{annotationId} {
      allow read, create: if true;
      allow update, delete: if isDesignatedAdmin();
    }

    // Draft Internal Revision Notes
    match /draft_notes/{noteId} {
      allow read, write, delete: if isDesignatedAdmin();
    }

    // Research Tips
    match /tips/{tipId} {
      allow create: if true; // Public can submit confidential tips
      allow read, update, delete: if isDesignatedAdmin();
    }

    // Manuscript Submissions & Investigation Pitches
    match /submissions/{submissionId} {
      allow create: if true; // Public researchers can submit manuscripts
      allow read, update, delete: if isDesignatedAdmin();
    }

    // System Metadata
    match /system_meta/{metaId} {
      allow read, write: if isDesignatedAdmin();
    }

    // General fallback block
    match /{document=**} {
      allow read: if true;
      allow write: if isDesignatedAdmin();
    }
  }
}


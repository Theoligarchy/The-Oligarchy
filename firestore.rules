rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════════════════
    // ZERO-TRUST RBAC & INTEGRITY PRIMITIVES
    // ════════════════════════════════════════════════════════════════

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Sole non-revocable owner & founder of The Oligarchy
    function isDesignatedOwner() {
      return isSignedIn() &&
             request.auth.token.email != null &&
             request.auth.token.email.lower() == 'theoligarchy.ppj@gmail.com';
    }

    // Role lookups in the official editorial_team registry
    function getEditorialUser(uid) {
      return get(/databases/$(database)/documents/editorial_team/$(uid)).data;
    }

    function isEditorialMember() {
      return isDesignatedOwner() ||
             (isSignedIn() && (
               (exists(/databases/$(database)/documents/editorial_team/$(request.auth.uid)) &&
                getEditorialUser(request.auth.uid).status != 'suspended') ||
               (request.auth.token.email != null && request.auth.token.email.lower() == 'saniasvb26@gmail.com')
             ));
    }

    function getEditorialRole() {
      return isDesignatedOwner() ? 'admin' :
             (request.auth.token.email != null && request.auth.token.email.lower() == 'saniasvb26@gmail.com') ? 'author' :
             (isEditorialMember() ? getEditorialUser(request.auth.uid).role : 'none');
    }

    function isManagingEditor() {
      return isDesignatedOwner() || (isEditorialMember() && getEditorialRole() == 'admin');
    }

    function isPeerReviewer() {
      return isManagingEditor() || (isEditorialMember() && getEditorialRole() == 'reviewer');
    }

    function isRegisteredAuthor() {
      return isEditorialMember() && (getEditorialRole() == 'author' || isManagingEditor());
    }

    // Document ID and payload sanity guards
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ════════════════════════════════════════════════════════════════
    // 1. EDITORIAL TEAM & RBAC REGISTRY
    // ════════════════════════════════════════════════════════════════
    match /editorial_team/{memberId} {
      // Public masthead can view active scholars; editorial staff can read all members
      allow read: if true;

      // Only Designated Owner can add or change member roles (prevents privilege escalation)
      allow create: if isDesignatedOwner() &&
                       isValidId(memberId) &&
                       incoming().uid is string &&
                       incoming().email is string &&
                       incoming().role in ['admin', 'reviewer', 'author'];

      // Owner can update any field; individual members can only update their personal bio/orcid (not role or status)
      allow update: if isDesignatedOwner() ||
                       (isSignedIn() && request.auth.uid == memberId &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['bio', 'orcid', 'institution', 'credentials', 'lastLoginAt']));

      // Only Designated Owner can revoke/delete editorial team records
      allow delete: if isDesignatedOwner();
    }

    // ════════════════════════════════════════════════════════════════
    // 2. ARTICLES & MANUSCRIPTS
    // ════════════════════════════════════════════════════════════════
    match /articles/{articleId} {
      // Public can read published articles. Editorial members can read working drafts.
      // An author can read their own drafts; managing editors and peer reviewers can read any draft
      allow read: if (resource.data.status == 'published') ||
                     isManagingEditor() ||
                     isPeerReviewer() ||
                     (isSignedIn() && (
                       resource.data.createdByUid == request.auth.uid ||
                       (request.auth.token.email != null && resource.data.createdByEmail == request.auth.token.email)
                     ));

      // Public view counts increment
      allow update: if (incoming().diff(existing()).affectedKeys().hasOnly(['views']) &&
                        incoming().views is number && incoming().views == existing().views + 1);

      // Managing Editor full article updates
      allow update: if isManagingEditor();

      // Author can update their OWN DRAFT only (cannot self-publish or alter ownership)
      allow update: if isEditorialMember() &&
                       existing().status == 'draft' &&
                       (existing().createdByUid == request.auth.uid ||
                        (request.auth.token.email != null && existing().createdByEmail == request.auth.token.email)) &&
                       incoming().status == 'draft' &&
                       incoming().createdByUid == existing().createdByUid &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'subtitle', 'slug', 'category', 'tags', 'featuredImage',
                         'excerpt', 'content', 'readTime', 'sources', 'coAuthors', 'updatedAt', 'seriesName', 'seriesPart'
                       ]);

      // Managing Editor can create any article. Authors can only create DRAFTS under their own UID.
      allow create: if isManagingEditor() ||
                       (isRegisteredAuthor() &&
                        incoming().status == 'draft' &&
                        incoming().createdByUid == request.auth.uid);

      // Managing editor can delete any article; authors can only delete their own DRAFTS
      allow delete: if isManagingEditor() ||
                       (isEditorialMember() &&
                        existing().status == 'draft' &&
                        existing().createdByUid == request.auth.uid);
    }

    // ════════════════════════════════════════════════════════════════
    // 3. EDITORIAL INVITATIONS (GUEST REVIEWERS)
    // ════════════════════════════════════════════════════════════════
    match /invitations/{inviteId} {
      // Only managing editors can inspect the full invitations list.
      // An invited recipient can validate their specific token document.
      allow read: if isManagingEditor() ||
                     (isSignedIn() && resource.data.recipientEmail == request.auth.token.email);

      // Only Managing Editor can generate invitations
      allow create: if isManagingEditor() &&
                       isValidId(inviteId) &&
                       incoming().token is string &&
                       incoming().articleId is string &&
                       incoming().status in ['pending', 'accepted'];

      // Managing Editor can update/revoke. Recipient can accept.
      allow update: if isManagingEditor() ||
                       (isSignedIn() &&
                        existing().recipientEmail == request.auth.token.email &&
                        existing().status == 'pending' &&
                        incoming().status == 'accepted' &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedAt']));

      allow delete: if isManagingEditor();
    }

    // ════════════════════════════════════════════════════════════════
    // 4. IMMUTABLE SECURITY & AUDIT TRAIL
    // ════════════════════════════════════════════════════════════════
    match /audit_logs/{logId} {
      // Only Managing Editors can read the audit trail
      allow read: if isManagingEditor();

      // Authenticated editorial members can append audit events
      allow create: if isEditorialMember() &&
                       isValidId(logId) &&
                       incoming().action is string &&
                       incoming().actorEmail is string &&
                       incoming().timestamp is number;

      // Audit logs are immutable (non-repudiation)
      allow update, delete: if false;
    }

    // ════════════════════════════════════════════════════════════════
    // 5. DRAFT INTERNAL MARGIN NOTES & FACT-CHECKING
    // ════════════════════════════════════════════════════════════════
    match /draft_notes/{noteId} {
      // All active editorial members can view draft internal notes for collaboration
      allow read: if isEditorialMember();

      allow create: if isEditorialMember() &&
                       incoming().content is string &&
                       incoming().content.size() <= 10000;

      // Note authors or Managing Editors can resolve or update notes
      allow update: if isManagingEditor() ||
                       (isEditorialMember() &&
                        (existing().authorEmail == request.auth.token.email ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resolvedAt', 'resolvedBy', 'replies'])));

      allow delete: if isManagingEditor() ||
                       (isEditorialMember() && existing().authorEmail == request.auth.token.email);
    }

    // ════════════════════════════════════════════════════════════════
    // 6. MANUSCRIPT SUBMISSION QUEUE & PUBLIC PITCHES
    // ════════════════════════════════════════════════════════════════
    match /submissions/{submissionId} {
      // Public researchers can submit pitches
      allow create: if isValidId(submissionId) &&
                       incoming().title is string &&
                       incoming().authorEmail is string &&
                       incoming().content is string;

      // Reviewers and Managing Editors can read review queue. Submitters can read their own.
      allow read: if isManagingEditor() ||
                     isPeerReviewer() ||
                     (isSignedIn() && resource.data.authorEmail == request.auth.token.email);

      // Managing Editors and Peer Reviewers can update review status and notes
      allow update: if isManagingEditor() ||
                       (isPeerReviewer() &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'peerReviewerFeedback', 'updatedAt']));

      allow delete: if isManagingEditor();
    }

    // ════════════════════════════════════════════════════════════════
    // 7. PUBLIC PEER ANNOTATIONS & MARGINALIA
    // ════════════════════════════════════════════════════════════════
    match /peer_reviews/{reviewId} {
      allow read: if true;
      allow create: if incoming().content is string && incoming().content.size() <= 10000;
      allow update, delete: if isManagingEditor();
    }

    match /peer_annotations/{annotationId} {
      allow read: if true;
      allow create: if incoming().content is string && incoming().content.size() <= 10000;
      allow update, delete: if isManagingEditor();
    }

    // ════════════════════════════════════════════════════════════════
    // 8. SITE SETTINGS, MASTHEAD & CONTRIBUTORS
    // ════════════════════════════════════════════════════════════════
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isManagingEditor();
    }

    match /contributors/{contributorId} {
      allow read: if true;
      allow write: if isManagingEditor();
    }

    match /reading/{itemId} {
      allow read: if true;
      allow write: if isManagingEditor();
    }

    // ════════════════════════════════════════════════════════════════
    // 9. SUBSCRIBERS & CONFIDENTIAL TIPS (STRICT PII ISOLATION)
    // ════════════════════════════════════════════════════════════════
    match /subscribers/{subscriberId} {
      allow create: if incoming().email is string;
      // Strict PII protection: only Managing Editor can access subscriber list
      allow read, update, delete: if isManagingEditor();
    }

    match /tips/{tipId} {
      allow create: if incoming().message is string;
      // Confidential whistleblower protection: only Managing Editor can inspect tips
      allow read, update, delete: if isManagingEditor();
    }

    // ════════════════════════════════════════════════════════════════
    // 10. TELEMETRY & ZERO-PII ANALYTICS
    // ════════════════════════════════════════════════════════════════
    match /views_log/{viewId} {
      allow create, update: if true;
      allow read: if true;
      allow delete: if isManagingEditor();
    }

    match /active_sessions/{sessionId} {
      allow read, write, delete: if true;
    }

    match /conversion_events/{eventId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isManagingEditor();
    }

    match /resonant_quote_interactions/{interactionId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isManagingEditor();
    }

    match /user_saved_articles/{savedId} {
      allow read, write, delete: if true;
    }

    match /saved_articles/{savedId} {
      allow read, write, delete: if true;
    }

    match /users/{userId} {
      allow read: if isManagingEditor();
      allow write: if false;
    }

    // Fallback default-deny catchall
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
